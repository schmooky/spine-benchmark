{
  "name": "spine-benchmark-monorepo",
  "private": true,
  "version": "3.0.0",
  "description": "Spine Benchmark monorepo",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @spine-benchmark/site",
    "build": "npm run build --workspace @spine-benchmark/site",
    "build:site": "npm run build --workspace @spine-benchmark/site",
    "build:metrics-impact-formula": "npm run build --workspace @spine-benchmark/metrics-impact-formula",
    "build:metrics-sampling": "npm run build --workspace @spine-benchmark/metrics-sampling",
    "build:metrics-analyzers": "npm run build --workspace @spine-benchmark/metrics-analyzers",
    "build:spinefolio": "npm run build --workspace @spine-benchmark/spinefolio",
    "build:pixi-crawler": "npm run build --workspace @spine-benchmark/pixi-crawler",
    "dev:bench-server": "npm run dev --workspace @spine-benchmark/bench-server",
    "build:bench-server": "npm run build --workspace @spine-benchmark/bench-server",
    "dev:bench-runner": "npm run dev --workspace @spine-benchmark/bench-runner",
    "build:bench-runner": "npm run build --workspace @spine-benchmark/bench-runner",
    "dev:crawler": "npm run dev --workspace @spine-benchmark/crawler-demo",
    "dev:watcher": "npm run dev --workspace @spine-benchmark/watcher",
    "build:watcher": "npm run build --workspace @spine-benchmark/watcher",
    "build:watcher-sidecar": "npm run build:sidecar --workspace @spine-benchmark/watcher",
    "publish:pixi-crawler": "npm publish --workspace @spine-benchmark/pixi-crawler --access public",
    "demo:spinefolio": "npm run demo --workspace @spine-benchmark/spinefolio --",
    "publish:spinefolio": "npm publish --workspace @spine-benchmark/spinefolio --access public",
    "preview": "npm run preview --workspace @spine-benchmark/site",
    "check:no-duplicate-formulas": "node scripts/check-no-duplicate-impact-formulas.mjs",
    "check:no-fancy-unicode": "node scripts/check-no-fancy-unicode.mjs",
    "check:lint": "npm run check:no-duplicate-formulas && npm run check:no-fancy-unicode",
    "test": "npm run check:lint && vitest run",
    "test:coverage": "npm run check:lint && vitest run --coverage",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && npm install --package-lock-only",
    "build:all": "node scripts/build-all-publishable.mjs",
    "size": "node scripts/size-check.mjs",
    "size:check": "node scripts/size-check.mjs --check",
    "size:update": "node scripts/size-check.mjs --update",
    "release": "npm run build:all && changeset publish",
    "snapshot": "node scripts/snapshot-release.mjs",
    "prepare": "node node_modules/husky/bin.js || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "node scripts/check-no-duplicate-impact-formulas.mjs",
      "node scripts/check-no-fancy-unicode.mjs"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@vitest/coverage-v8": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
