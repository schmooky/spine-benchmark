{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@spine-benchmark/pixi-crawler": ["../../packages/pixi-crawler/src/index.ts"],
      "@spine-benchmark/pixi-crawler/core": ["../../packages/pixi-crawler/src/core/index.ts"],
      "@spine-benchmark/pixi-crawler/ui": ["../../packages/pixi-crawler/src/ui/index.ts"]
    }
  },
  "include": ["src"]
}
