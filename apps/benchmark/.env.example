# ── Benchmark app environment variables (build-time via Vite) ─────
# Copy to .env.local for development. In CI/deploy, set these as
# environment variables.
#
# Vite injects VITE_* vars at build time via import.meta.env.VITE_*.

# URL of the reports API server. When set, the benchmark UI shows a
# "Share report" button that uploads the current analysis + screenshot
# to the API and returns a public link.
#
# Leave unset to disable the share feature entirely.
# Development:  http://localhost:3001
# Production:   https://reports.spine.schmooky.dev  (or wherever you deploy)
VITE_REPORTS_API_URL=http://localhost:3001
