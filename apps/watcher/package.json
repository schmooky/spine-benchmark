{
  "name": "@spine-benchmark/watcher",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Spine animation watcher - auto-exports and analyzes .spine projects on every save",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:bundle": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/bundle.cjs --external:chokidar --external:fsevents",
    "build:bin": "npm run build:bundle && pkg dist/bundle.cjs --targets node20-macos-arm64,node20-macos-x64,node20-win-x64 --output dist/spine-watcher",
    "start": "node dist/main.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "pkg": {
    "assets": [
      "node_modules/@esotericsoftware/**/*"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@esotericsoftware/spine-core": "^4.2.101",
    "@spine-benchmark/metrics-impact-formula": "^0.1.0",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
