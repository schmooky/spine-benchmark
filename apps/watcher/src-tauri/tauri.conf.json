{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Spine Watcher",
  "version": "0.1.0",
  "identifier": "dev.schmooky.spine-watcher",
  "build": {
    "frontendDist": "../ui"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/spine-watcher-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Spine Watcher",
        "width": 840,
        "height": 600,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true,
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "Spine Watcher"
    }
  }
}
