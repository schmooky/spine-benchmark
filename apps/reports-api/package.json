{
  "name": "@spine-benchmark/reports-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for shareable Spine benchmark reports. Stores analysis data + screenshots to S3, returns share links with 7-day TTL.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build --workspace @spine-benchmark/spinefolio && tsc -p tsconfig.json && node scripts/copy-templates.mjs",
    "start": "node dist/server.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@spine-benchmark/spinefolio": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "handlebars": "^4.7.9",
    "multer": "^1.4.5-lts.2",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^25.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
