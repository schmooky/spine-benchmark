# ── reports-api environment variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# On Timeweb App Platform, set these as environment variables in the dashboard.

# Port the server listens on. Timeweb typically injects PORT automatically.
PORT=3001

# ── S3-compatible storage (Timeweb S3, AWS, MinIO, etc.) ──────────

# Timeweb S3 endpoint (e.g. https://s3.timeweb.cloud)
S3_ENDPOINT=https://s3.timeweb.cloud

# Region (Timeweb uses "ru-1" by default)
S3_REGION=ru-1

# Bucket name. Create it in the Timeweb S3 dashboard first.
S3_BUCKET=spine-benchmark-reports

# Access credentials. Create a service account in Timeweb S3 dashboard.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Public URL ────────────────────────────────────────────────────

# The externally-reachable URL of this API server. Used to construct
# share links (e.g. https://reports.spine.schmooky.dev).
PUBLIC_URL=http://localhost:3001

# ── Report TTL ────────────────────────────────────────────────────

# Reports older than this many days are eligible for cleanup.
# Default: 7 (one week).
REPORT_TTL_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────

# Allowed origin for the benchmark frontend. In production, set to your
# benchmark site URL (e.g. https://spine.schmooky.dev).
# Use * for development.
CORS_ORIGIN=*
