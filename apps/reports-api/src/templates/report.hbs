<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{meta.skeletonName}} - Spine Benchmark Report</title>
  <meta name="description" content="Spine performance analysis for {{meta.skeletonName}} - {{meta.totalAnimations}} animations, Spine {{meta.spineVersion}}">
  <meta property="og:title" content="{{meta.skeletonName}} - Spine Benchmark">
  <meta property="og:description" content="RI: {{analysis.summary.rendering.worst.level}} ({{fixed analysis.summary.rendering.worst.cost 1}}) / CI: {{analysis.summary.computational.worst.level}} ({{fixed analysis.summary.computational.worst.cost 1}}) - {{meta.totalAnimations}} animations">
  {{#if mainScreenshot}}<meta property="og:image" content="{{mainScreenshot}}">{{/if}}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  {{> styles}}
</head>
<body>
<div class="page">
  {{> header}}

  {{#if mainScreenshot}}
  <img class="hero-img" src="{{mainScreenshot}}" alt="{{meta.skeletonName}} preview" />
  {{/if}}

  {{> impactCards}}
  {{> hotspots}}
  {{> advisor}}

  {{#if analysis.animations.length}}
  <h2>Animation Details</h2>
  <div class="anim-grid">
    {{#each analysis.animations}}
    {{> animationCard}}
    {{/each}}
  </div>
  {{/if}}

  {{> comparisonTable}}
  {{> fileHashes}}

  <div class="footer">
    Generated by <a href="https://github.com/schmooky/spine-benchmark" target="_blank">Spine Benchmark</a>
    | Report {{meta.id}} | {{formatDate meta.createdAt}}
  </div>
</div>
</body>
</html>
