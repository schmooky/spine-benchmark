<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{meta.skeletonName}} - Spine Benchmark Report</title>
  <meta name="description" content="Spine performance analysis for {{meta.skeletonName}} - {{meta.totalAnimations}} animations, Spine {{meta.spineVersion}}">
  <meta property="og:title" content="{{meta.skeletonName}} - Spine Benchmark">
  <meta property="og:description" content="RI: {{analysis.summary.rendering.worst.level}} ({{fixed analysis.summary.rendering.worst.cost 1}}) / CI: {{analysis.summary.computational.worst.level}} ({{fixed analysis.summary.computational.worst.cost 1}}) - {{meta.totalAnimations}} animations">
  {{#if mainScreenshot}}<meta property="og:image" content="{{mainScreenshot}}">{{/if}}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
  {{> styles}}
</head>
<body>
<div class="page">
  {{> header}}

  {{#if mainScreenshot}}
  <img class="hero-img" src="{{mainScreenshot}}" alt="{{meta.skeletonName}} preview" />
  {{/if}}

  {{> impactCards}}
  {{> hotspots}}
  {{> advisor}}

  {{#if analysis.animations.length}}
  <h2>Animation Details</h2>
  <div class="anim-grid">
    {{#each analysis.animations}}
    {{> animationCard}}
    {{/each}}
  </div>
  {{/if}}

  {{> comparisonTable}}
  {{> fileHashes}}

  <div class="footer">
    Generated by <a href="https://github.com/schmooky/spine-benchmark" target="_blank">Spine Benchmark</a>
    | Report {{meta.id}} | {{formatDate meta.createdAt}}
  </div>
</div>

<!-- Embedded timeline data for d3 heatmaps -->
<script id="timeline-data" type="application/json">{{{timelineJson}}}</script>
<script>
(function() {
  var raw = document.getElementById('timeline-data');
  if (!raw) return;
  var timelines;
  try { timelines = JSON.parse(raw.textContent); } catch(e) { return; }

  var COLORS = {
    ri: '#FB923C',
    ci: '#60A5FA',
    bg: '#0E1117',
    grid: 'rgba(240,246,252,0.06)',
    text: '#545D68',
    thresholds: [
      { val: 3, color: 'rgba(163,230,53,0.2)' },
      { val: 8, color: 'rgba(251,191,36,0.2)' },
      { val: 15, color: 'rgba(251,146,60,0.2)' },
      { val: 25, color: 'rgba(248,113,113,0.25)' },
    ]
  };

  document.querySelectorAll('.heatmap[data-anim]').forEach(function(el) {
    var name = el.getAttribute('data-anim');
    var data = timelines[name];
    if (!data || data.length < 2) {
      el.style.display = 'none';
      return;
    }

    var W = el.clientWidth || 300;
    var H = 64;
    var M = { top: 4, right: 8, bottom: 18, left: 28 };
    var w = W - M.left - M.right;
    var h = H - M.top - M.bottom;

    var maxVal = Math.max(1, d3.max(data, function(d) { return d.ri + d.ci; }));

    var x = d3.scaleLinear().domain([0, data[data.length - 1].time]).range([0, w]);
    var y = d3.scaleLinear().domain([0, maxVal]).range([h, 0]);

    var svg = d3.select(el).append('svg')
      .attr('width', W).attr('height', H)
      .style('border-radius', '3px')
      .style('border', '1px solid rgba(240,246,252,0.08)');

    // Background
    svg.append('rect').attr('width', W).attr('height', H).attr('fill', COLORS.bg);

    var g = svg.append('g').attr('transform', 'translate(' + M.left + ',' + M.top + ')');

    // Threshold lines
    COLORS.thresholds.forEach(function(t) {
      if (t.val < maxVal) {
        g.append('line')
          .attr('x1', 0).attr('x2', w)
          .attr('y1', y(t.val)).attr('y2', y(t.val))
          .attr('stroke', t.color).attr('stroke-width', 1)
          .attr('stroke-dasharray', '2,3');
      }
    });

    // CI area (stacked on top of RI)
    var areaTotal = d3.area()
      .x(function(d) { return x(d.time); })
      .y0(h)
      .y1(function(d) { return y(d.ri + d.ci); })
      .curve(d3.curveMonotoneX);

    g.append('path').datum(data)
      .attr('d', areaTotal)
      .attr('fill', COLORS.ci).attr('opacity', 0.25);

    // RI area (bottom)
    var areaRI = d3.area()
      .x(function(d) { return x(d.time); })
      .y0(h)
      .y1(function(d) { return y(d.ri); })
      .curve(d3.curveMonotoneX);

    g.append('path').datum(data)
      .attr('d', areaRI)
      .attr('fill', COLORS.ri).attr('opacity', 0.35);

    // RI line
    var lineRI = d3.line()
      .x(function(d) { return x(d.time); })
      .y(function(d) { return y(d.ri); })
      .curve(d3.curveMonotoneX);

    g.append('path').datum(data)
      .attr('d', lineRI)
      .attr('fill', 'none').attr('stroke', COLORS.ri)
      .attr('stroke-width', 1.5).attr('opacity', 0.9);

    // CI+RI line
    var lineTotal = d3.line()
      .x(function(d) { return x(d.time); })
      .y(function(d) { return y(d.ri + d.ci); })
      .curve(d3.curveMonotoneX);

    g.append('path').datum(data)
      .attr('d', lineTotal)
      .attr('fill', 'none').attr('stroke', COLORS.ci)
      .attr('stroke-width', 1.5).attr('opacity', 0.7);

    // X axis (time)
    var xAxis = d3.axisBottom(x).ticks(5).tickFormat(function(d) { return d + 's'; });
    g.append('g')
      .attr('transform', 'translate(0,' + h + ')')
      .call(xAxis)
      .selectAll('text').attr('fill', COLORS.text).attr('font-size', '8px');
    g.selectAll('.domain, .tick line').attr('stroke', COLORS.grid);

    // Y axis (cost)
    var yAxis = d3.axisLeft(y).ticks(3).tickFormat(d3.format('.0f'));
    g.append('g')
      .call(yAxis)
      .selectAll('text').attr('fill', COLORS.text).attr('font-size', '8px');
    g.selectAll('.domain, .tick line').attr('stroke', COLORS.grid);

    // Legend
    var legend = svg.append('g').attr('transform', 'translate(' + (M.left + 4) + ',' + (M.top + 2) + ')');
    legend.append('rect').attr('width', 8).attr('height', 8).attr('rx', 1).attr('fill', COLORS.ri).attr('opacity', 0.8);
    legend.append('text').attr('x', 11).attr('y', 7).text('RI').attr('fill', COLORS.ri).attr('font-size', '8px').attr('font-family', 'var(--sb-font-mono)');
    legend.append('rect').attr('x', 30).attr('width', 8).attr('height', 8).attr('rx', 1).attr('fill', COLORS.ci).attr('opacity', 0.6);
    legend.append('text').attr('x', 41).attr('y', 7).text('CI').attr('fill', COLORS.ci).attr('font-size', '8px').attr('font-family', 'var(--sb-font-mono)');
  });
})();
</script>
</body>
</html>
