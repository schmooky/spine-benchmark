<style>
  :root {
    --sb-bg-0: #08090C;
    --sb-bg-1: #0E1117;
    --sb-bg-2: #161A21;
    --sb-bg-3: #1E232B;
    --sb-bg-4: #262C36;
    --sb-border: rgba(240, 246, 252, 0.08);
    --sb-border-strong: rgba(240, 246, 252, 0.16);
    --sb-text: #E4E8EE;
    --sb-text-secondary: #8B949E;
    --sb-text-muted: #545D68;
    --sb-accent: #2DD4A8;
    --sb-accent-hover: #3AEAB8;
    --sb-accent-dim: rgba(45, 212, 168, 0.12);
    --sb-success: #34D399;
    --sb-warning: #FBBF24;
    --sb-error: #F87171;
    --sb-info: #60A5FA;
    --sb-radius-sm: 3px;
    --sb-radius-md: 6px;
    --sb-radius-lg: 8px;
    --sb-shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
    --sb-shadow-md: 0 4px 12px rgba(0,0,0,0.4);
    --sb-font-ui: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --sb-font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: var(--sb-font-ui); background: var(--sb-bg-1); color: var(--sb-text); line-height: 1.6; -webkit-font-smoothing: antialiased; }
  .page { max-width: 960px; margin: 0 auto; padding: 32px 24px 80px; }

  /* Header - matches benchmark's route header */
  .header { padding-bottom: 20px; border-bottom: 1px solid var(--sb-border); margin-bottom: 24px; }
  .header-row { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }
  .logo { width: 36px; height: 36px; border-radius: var(--sb-radius-md); background: var(--sb-accent); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; color: var(--sb-bg-0); flex-shrink: 0; }
  .header h1 { font-size: 1.15rem; color: var(--sb-text); font-weight: 600; line-height: 1.3; }
  .header h1 span { color: var(--sb-accent); font-weight: 700; }
  .header-meta { color: var(--sb-text-muted); font-size: 0.72rem; display: flex; gap: 16px; flex-wrap: wrap; }

  /* Badges - exact benchmark site values */
  .badge { display: inline-block; padding: 2px 8px; border-radius: var(--sb-radius-sm); font-size: 11px; font-weight: 600; line-height: 1.4; }
  .badge-minimal { background: rgba(52,211,153,0.12); color: #34D399; }
  .badge-low { background: rgba(163,230,53,0.12); color: #A3E635; }
  .badge-moderate { background: rgba(251,191,36,0.12); color: #FBBF24; }
  .badge-high { background: rgba(251,146,60,0.12); color: #FB923C; }
  .badge-very-high { background: rgba(248,113,113,0.12); color: #F87171; }

  .v-minimal, .v-low { color: var(--sb-success); }
  .v-moderate { color: var(--sb-warning); }
  .v-high { color: #FB923C; }
  .v-very-high { color: var(--sb-error); }

  /* Hero screenshot */
  .hero-img { width: 200px; height: 200px; object-fit: contain; border-radius: var(--sb-radius-lg); border: 1px solid var(--sb-border-strong); margin-bottom: 24px; display: block; background: var(--sb-bg-0); }

  /* Impact summary cards - matches .impact-summary-card */
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px; }
  .card { background: var(--sb-bg-2); border: 1px solid var(--sb-border); border-radius: var(--sb-radius-md); padding: 14px; }
  .card-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--sb-text-secondary); font-weight: 600; margin-bottom: 6px; }
  .card-value { font-size: 1.8rem; font-weight: 700; font-family: var(--sb-font-mono); line-height: 1.2; }

  /* Section headings - matches benchmark's section labels */
  h2 { font-size: 11px; color: var(--sb-text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin: 28px 0 10px; }

  /* Hotspot grid */
  .hotspots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .hotspot { background: var(--sb-bg-2); border: 1px solid var(--sb-border); border-radius: var(--sb-radius-md); padding: 12px; text-align: center; }
  .hotspot-val { font-size: 1.3rem; font-weight: 700; font-family: var(--sb-font-mono); }
  .hotspot-label { font-size: 10px; color: var(--sb-text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-top: 2px; }

  /* Advisor - severity-colored left border like benchmark's advisor cards */
  .advisor-item { background: var(--sb-bg-2); border: 1px solid var(--sb-border); border-radius: var(--sb-radius-md); padding: 12px 14px; margin-bottom: 8px; border-left: 3px solid var(--sb-text-muted); }
  .advisor-item.sev-warning { border-left-color: var(--sb-warning); }
  .advisor-item.sev-critical { border-left-color: var(--sb-error); }
  .advisor-item.sev-info { border-left-color: var(--sb-accent); }
  .advisor-title { font-weight: 600; font-size: 12px; color: var(--sb-text); margin-bottom: 2px; }
  .advisor-desc { font-size: 11px; color: var(--sb-text-secondary); line-height: 1.5; }
  .advisor-anims { margin-top: 6px; display: flex; gap: 4px; flex-wrap: wrap; }
  .advisor-anims span { font-size: 10px; background: var(--sb-bg-3); padding: 1px 6px; border-radius: var(--sb-radius-sm); color: var(--sb-text-muted); }

  /* Animation detail cards */
  .anim-grid { display: flex; flex-direction: column; gap: 10px; }
  .anim-card { background: var(--sb-bg-2); border: 1px solid var(--sb-border); border-radius: var(--sb-radius-md); overflow: hidden; }
  .anim-header { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid var(--sb-border); }
  .anim-header h3 { font-size: 12px; font-weight: 600; }
  .anim-header .dur { font-family: var(--sb-font-mono); font-size: 11px; color: var(--sb-text-muted); display: flex; align-items: center; gap: 6px; }
  .anim-body { display: grid; grid-template-columns: 180px 1fr; }
  .anim-gif { width: 180px; height: 180px; object-fit: contain; background: var(--sb-bg-0); border-right: 1px solid var(--sb-border); display: block; border-radius: var(--sb-radius-sm); }
  .anim-placeholder { width: 180px; height: 180px; display: flex; align-items: center; justify-content: center; color: var(--sb-text-muted); font-size: 10px; background: var(--sb-bg-0); border-right: 1px solid var(--sb-border); }
  .anim-metrics { padding: 12px 14px; }
  .metrics-row { display: flex; gap: 16px; margin-bottom: 6px; }
  .metric { flex: 1; }
  .metric-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--sb-text-muted); font-weight: 500; }
  .metric-value { font-family: var(--sb-font-mono); font-size: 13px; font-weight: 600; }
  .features { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 6px; }
  .feat { font-size: 10px; padding: 1px 6px; border-radius: var(--sb-radius-sm); background: var(--sb-bg-3); color: var(--sb-text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .feat.on { color: var(--sb-accent); background: var(--sb-accent-dim); }

  /* Table - exact match of .benchmark-table */
  table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 12px; }
  thead th { text-align: left; font-weight: 600; font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--sb-text-secondary); padding: 8px 10px; background: var(--sb-bg-1); border-bottom: 1px solid var(--sb-border-strong); white-space: nowrap; }
  tbody td { padding: 7px 10px; vertical-align: middle; border-bottom: 1px solid var(--sb-border); color: var(--sb-text); }
  tbody tr:hover td { background: var(--sb-bg-2); }
  .num { font-family: var(--sb-font-mono); text-align: right; }
  .row-danger { background: rgba(248,113,113,0.06); border-left: 2px solid var(--sb-error); }
  .row-warning { background: rgba(251,191,36,0.06); border-left: 2px solid var(--sb-warning); }

  /* d3 heatmap timeline */
  .heatmap { margin: 8px 0 6px; }
  .heatmap svg { display: block; }

  /* File hashes */
  .hashes { background: var(--sb-bg-2); border: 1px solid var(--sb-border); border-radius: var(--sb-radius-md); padding: 12px 14px; font-family: var(--sb-font-mono); font-size: 10px; }
  .hashes dt { color: var(--sb-accent); margin-top: 8px; }
  .hashes dt:first-child { margin-top: 0; }
  .hashes dd { color: var(--sb-text-muted); word-break: break-all; }

  /* Footer */
  .footer { text-align: center; color: var(--sb-text-muted); font-size: 10px; margin-top: 32px; padding-top: 12px; border-top: 1px solid var(--sb-border); }
  .footer a { color: var(--sb-accent); text-decoration: none; }

  .expired { text-align: center; padding: 120px 20px; color: var(--sb-text-muted); }

  @media (max-width: 700px) {
    .cards { grid-template-columns: 1fr; }
    .hotspots { grid-template-columns: repeat(2, 1fr); }
    .anim-body { grid-template-columns: 1fr; }
    .anim-gif, .anim-placeholder { width: 100%; height: 180px; border-right: none; border-bottom: 1px solid var(--sb-border); }
  }
</style>
