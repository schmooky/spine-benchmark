{
  "name": "@spine-benchmark/bench-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Device calibration benchmark client (spine-run.schmooky.dev). Runs bundled Spine scenarios for ~5 minutes, captures detailed metrics and uploads them to bench-server.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "^4.2.101",
    "@spine-benchmark/metrics-impact-formula": "^0.1.1",
    "pixi.js": "^8.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.3",
    "@spine-benchmark/gpu-timing": "^0.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.9.3",
    "vite": "^8.0.8"
  }
}
