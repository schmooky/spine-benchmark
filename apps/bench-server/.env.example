# bench-server environment

# Port to listen on
PORT=8787

# postgres | memory  (memory = local dev only, nothing persists)
STORAGE_MODE=postgres

# Postgres connection string
DATABASE_URL=postgres://spinebench:spinebench@localhost:5432/spinebench

# S3-compatible storage for full per-frame captures (Timeweb S3, MinIO, AWS)
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_BUCKET=spine-bench-captures
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Allowed browser origins, comma-separated
CORS_ORIGINS=https://spine-run.schmooky.dev,http://localhost:5190

# Public base URL used in report links returned to the client
PUBLIC_URL=https://spine-bench.schmooky.dev

# pino log level: trace|debug|info|warn|error
LOG_LEVEL=info

# Max POST body size (full capture rides in the upload)
BODY_LIMIT=25mb
