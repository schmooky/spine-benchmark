{
  "name": "@spine-benchmark/pixi-crawler",
  "version": "0.3.0",
  "type": "module",
  "description": "Drop-in PixiJS 8 performance crawler: per-frame phase timing, workload counters, HUD, worst-frame inspector, and telemetry",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dev": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "spine",
    "animation",
    "pixi",
    "performance",
    "profiler",
    "debug"
  ],
  "author": "Spine Benchmark Contributors",
  "license": "MIT",
  "peerDependencies": {
    "pixi.js": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "pixi.js": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schmooky/spine-benchmark.git",
    "directory": "packages/pixi-crawler"
  },
  "homepage": "https://github.com/schmooky/spine-benchmark/tree/main/packages/pixi-crawler#readme",
  "bugs": {
    "url": "https://github.com/schmooky/spine-benchmark/issues"
  }
}
