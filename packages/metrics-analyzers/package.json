{
  "name": "@spine-benchmark/metrics-analyzers",
  "version": "0.2.0",
  "description": "Device cost-model toolkit: per-GPU-family fitted ms model (deviceFit) and portable-family device classification (deviceClass)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./deviceClass": {
      "types": "./dist/deviceClass.d.ts",
      "import": "./dist/deviceClass.js"
    },
    "./deviceFit": {
      "types": "./dist/deviceFit.d.ts",
      "import": "./dist/deviceFit.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prebuild": "npm run build --prefix ../.. --workspace @spine-benchmark/metrics-impact-formula --workspace @spine-benchmark/metrics-model"
  },
  "dependencies": {
    "@spine-benchmark/metrics-impact-formula": "^0.2.0",
    "@spine-benchmark/metrics-model": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schmooky/spine-benchmark.git",
    "directory": "packages/metrics-analyzers"
  },
  "homepage": "https://github.com/schmooky/spine-benchmark/tree/main/packages/metrics-analyzers#readme",
  "bugs": {
    "url": "https://github.com/schmooky/spine-benchmark/issues"
  }
}
